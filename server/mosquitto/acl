# /etc/mosquitto/acl

# Устройства и iot-backend — как раньше, без ограничений.
user iot
topic readwrite #

# Браузер на странице со стримом: чтение кадров и статуса камеры, плюс пинг
# «я смотрю», по которому камера включает поток. Пароль этого пользователя
# лежит в config.js страницы (страница закрыта basic auth в Caddy), поэтому
# прав у него — минимум.
user spider-viewer
topic read spider/cam/frame
topic read home/spider-cam/status
topic write spider/cam/viewer
